# Conexão com o PostgreSQL (veja docker-compose.yml para subir um banco local)
DATABASE_URL="postgresql://estudei:estudei@localhost:5432/estudei?schema=public"

# Segredo usado para assinar os tokens JWT de sessão.
# Gere um valor aleatório com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Segredo que protege o endpoint do job agendado (/api/cron/recalculate).
# Envie no cabeçalho: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="troque-por-outro-segredo"
